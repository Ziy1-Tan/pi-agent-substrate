# ActorTemplate for local and clustered deployments, in ateapi protojson form.
#
# The template is immutable. Changing the image, env, resources, or the
# sandbox-class selector means creating a new template (and a new actor that
# uses it).
#
# ${...} placeholders are filled by hack/e2e-kind.sh or hack/deploy-local.sh:
#   ACTOR_IMAGE        digest-pinned actor image in the local registry
#   PROVIDER           provider id
#   MODEL_ID           model id
#   BASE_URL           provider endpoint
#   API                wire protocol, e.g. openai-completions
#   CONTEXT_WINDOW     model context window
#   MAX_TOKENS         model output limit
#   SANDBOX_CLASS_NAME microvm or gvisor, matching the WorkerPool label
metadata:
  atespace: pi-agents
  name: pi-actor
# v1.0.0 selects the sandbox class through the WorkerPool, not through a
# template field. Match the label the pool carries so a cluster with both
# classes places the actor deterministically.
workerSelector:
  matchLabels:
    workload: pi
    sandboxClass: '${SANDBOX_CLASS_NAME}'
containers:
- name: bridge
  image: ${ACTOR_IMAGE}
  env:
  - name: PI_PROVIDER
    value: '${PROVIDER}'
  - name: PI_MODEL
    value: '${MODEL_ID}'
  # The bridge composes Pi's models.json from these values at startup. The API
  # key is deliberately absent: Pi sends a placeholder Authorization header
  # and the egress gateway replaces it.
  - name: PI_PROVIDER_BASE_URL
    value: '${BASE_URL}'
  - name: PI_PROVIDER_API
    value: '${API}'
  - name: PI_MODEL_CONTEXT_WINDOW
    value: '${CONTEXT_WINDOW}'
  - name: PI_MODEL_MAX_TOKENS
    value: '${MAX_TOKENS}'
  # Actor egress only passes the urls an EgressPolicy allows; Pi's startup
  # update and model-catalog checks would otherwise wait on a denied request.
  - name: PI_OFFLINE
    value: "1"
  - name: PI_SKIP_VERSION_CHECK
    value: "1"
  # An `https` egress rule is terminated at the gateway, which mints the leaf
  # the actor sees. That leaf chains to the substrate CA, not a public root,
  # so Node rejects it unless the projected bundle is trusted. Without this
  # Pi reports a bare "Connection error." after the TLS handshake.
  - name: NODE_EXTRA_CA_CERTS
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  - name: SSL_CERT_FILE
    value: /run/ate/egress-trust-bundle/trust-bundle.pem
  # Deliberately no wakeupProbe. Declaring one on every container drops the
  # controller's golden-snapshot warmup to zero
  # (goldenSnapshotWarmupFor in template_reconciler.go): the probe is trusted
  # to mean "ready", and here it does not. The bridge answers /healthz as soon
  # as it binds the port, roughly 500ms after start, and snapshotting a Node
  # process at that moment produces a restore whose bridge never listens again
  # -- the resume then times out on the same probe and the actor is CRASHED.
  # Without a probe the controller waits its 20s warmup. v1.0.0 still supports
  # that fallback. Switch to a probe only after /healthz answers 503 until the
  # process is old enough for the snapshot to be safe.
  volumeMounts:
  - name: workspace
    mountPath: /workspace
  - name: system-info
    mountPath: /run/ate
# v1.0.0 sizes the actor in integer units, not Kubernetes quantities.
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 1073741824
snapshotConfig:
  # MEMORY keeps the Pi process warm across suspend, which is the point of the
  # always-on path: a resume replays no cold boot.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  # No storageLocation. v1.0.0 stores snapshots under ate-api-server's
  # --snapshot-location unless the PerTemplateSnapshotLocation preview gate is
  # enabled and the client opts in with --preview.
volumes:
- name: workspace
  durableDir: {}
# Projected trust anchors: the egress gateway CA plus public roots. Substrate
# only resolves these well-known bundle names.
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: egress-trust-bundle/trust-bundle.pem
