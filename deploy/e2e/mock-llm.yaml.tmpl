# Mock LLM for the clustered e2e. The namespace and WorkerPool come from
# deploy/workerpool.yaml.tmpl, which scripts/e2e/kind.sh applies first.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-llm
  namespace: ${ATESPACE}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-llm
  template:
    metadata:
      labels:
        app: mock-llm
    spec:
      containers:
      - name: mock-llm
        image: ${MOCK_LLM_IMAGE}
        # The e2e rebuilds :dev with the same tag; always pull so a stale
        # cached layer set cannot resurrect an old binary.
        imagePullPolicy: Always
        env:
        - name: MOCK_TEXT
          value: "Hello from the mock model."
        - name: MOCK_PORT
          value: "8080"
        ports:
        - containerPort: 8080
        readinessProbe:
          httpGet:
            path: /v1/models
            port: 8080
          initialDelaySeconds: 1
          periodSeconds: 2
---
apiVersion: v1
kind: Service
metadata:
  name: mock-llm
  namespace: ${ATESPACE}
spec:
  selector:
    app: mock-llm
  ports:
  - port: 8080
    targetPort: 8080
