# Local, single-user setup: the actor may reach the model provider.
#
# The provider is reached over TLS, so the rule is `https`, not `http`. An
# `http` rule only authorizes cleartext traffic and contributes no SNI rule;
# with no SNI rule the egress data plane denies the TLS handshake outright,
# which Pi reports as a bare "Connection error."
#
# The API key is not in this file and not in the actor: the template holds a
# placeholder, and `replaceHeaders` swaps the Authorization header for the
# value from the Kubernetes Secret on the way out. The gateway terminates TLS
# to do that, which is why the actor also mounts the egress trust bundle.
#
# ${PROVIDER_HOST}, ${PROVIDER_PORT}, and ${CREDENTIAL_URI} are filled in by
# hack/deploy-local.sh.
metadata:
  atespace: pi-agents
  name: default
rules:
- https:
    hostnames:
    - ${PROVIDER_HOST}
    ports:
      numbers:
      - ${PROVIDER_PORT}
    effects:
      replaceHeaders:
      - header: Authorization
        prefix: "Bearer "
        credentialUri: ${CREDENTIAL_URI}
