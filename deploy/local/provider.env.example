# Copy to deploy/local/provider.env and fill in. That file is gitignored.
#
# These are the only values Pi needs to call one model through one provider.
# The endpoint and wire API are ordinary configuration; the API key is written
# to a Kubernetes Secret and injected by the egress gateway, so it never enters
# the actor.
#
# PI_PROVIDER_API is the wire protocol, not the provider brand. Use
# `openai-completions` for OpenAI-compatible endpoints and
# `anthropic-messages` for Anthropic-compatible ones.

PI_PROVIDER=tokenhub
PI_MODEL=deepseek-v4-pro
PI_PROVIDER_BASE_URL=https://api.example.com/v1
PI_PROVIDER_API=openai-completions
PI_PROVIDER_API_KEY=sk-replace-me

# Pi defaults a model to contextWindow 128000 and maxTokens 16384. Uncomment
# either line only when the provider's model differs.
# PI_MODEL_CONTEXT_WINDOW=128000
# PI_MODEL_MAX_TOKENS=16384
