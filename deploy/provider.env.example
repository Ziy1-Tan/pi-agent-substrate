# Copy to deploy/provider.env and fill in. That file is gitignored.
#
# These are the only values the actor needs to call one model through one provider.
# The endpoint must be OpenAI-compatible (openai-completions). The API key is
# written to a Kubernetes Secret and injected by the egress gateway, so it never
# enters the actor.

PI_PROVIDER=tokenhub
PI_MODEL=deepseek-v4-pro
PI_PROVIDER_BASE_URL=https://api.example.com/v1
PI_PROVIDER_API_KEY=sk-replace-me

# The actor defaults a model to contextWindow 128000 and maxTokens 16384. Uncomment
# either line only when the provider's model differs.
# PI_MODEL_CONTEXT_WINDOW=128000
# PI_MODEL_MAX_TOKENS=16384
