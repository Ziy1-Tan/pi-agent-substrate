# Namespace, worker pool, mock LLM, and actor template for the clustered e2e.
#
# The WorkerPool runs the gVisor sandbox class, which is what this workstation
# supports (no /dev/kvm inside the Docker VM). The actor template is a substrate
# resource created through the ate API, not a CRD; hack/e2e-kind.sh applies it.
apiVersion: v1
kind: Namespace
metadata:
  name: pi-agents
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: pi-workerpool
  namespace: pi-agents
  labels:
    workload: pi
spec:
  replicas: 1
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits:
        cpu: "2"
        memory: 2Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mock-llm
  namespace: pi-agents
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mock-llm
  template:
    metadata:
      labels:
        app: mock-llm
    spec:
      containers:
      - name: mock-llm
        image: ${MOCK_LLM_IMAGE}
        # The e2e rebuilds :dev with the same tag; always pull so a stale
        # cached layer set cannot resurrect an old binary.
        imagePullPolicy: Always
        env:
        - name: MOCK_TEXT
          value: "Hello from the mock model."
        - name: MOCK_PORT
          value: "8080"
        ports:
        - containerPort: 8080
        readinessProbe:
          httpGet:
            path: /v1/models
            port: 8080
          initialDelaySeconds: 1
          periodSeconds: 2
---
apiVersion: v1
kind: Service
metadata:
  name: mock-llm
  namespace: pi-agents
spec:
  selector:
    app: mock-llm
  ports:
  - port: 8080
    targetPort: 8080
