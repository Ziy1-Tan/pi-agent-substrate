{
  "name": "pi-agent-substrate",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on Pi agents on Agent Substrate",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
