    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "0.46.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "substrateVersion": "1.0.0"
}
