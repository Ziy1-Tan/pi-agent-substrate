    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "0.46.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "piVersion": "0.84.2",
  "substrateVersion": "1.0.0"
}
